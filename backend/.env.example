# TravelForge Backend Environment

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (local Docker or hosted provider)
DATABASE_URL=postgresql://user:password@localhost:5432/travelforge

# AI Providers (at least one required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here   # optional fallback

# Embedding model (OpenAI)
EMBEDDING_MODEL=text-embedding-3-small

# ChromaDB (local persistent storage — no Docker needed)
CHROMA_PERSIST_PATH=./chroma_storage
CHROMA_COLLECTION_NAME=business_knowledge
QDRANT_CLUSTER_ENDPOINT_KEY=https://your-qdrant-cluster-url
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=business_knowledge

# LLM models
CHAT_MODEL=gpt-4o
AUDIT_MODEL=gpt-4o
RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.55
