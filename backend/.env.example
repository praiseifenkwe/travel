# TravelForge Backend Environment
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://travelforge:travelforge@localhost:5432/travelforge
# Sync URL for Alembic if needed:
# SYNC_DATABASE_URL=postgresql://travelforge:travelforge@localhost:5432/travelforge

# Redis Pub/Sub & Task Queue
REDIS_URL=redis://localhost:6379/0

# AI Provider
OPENAI_API_KEY=your_openai_api_key_here
